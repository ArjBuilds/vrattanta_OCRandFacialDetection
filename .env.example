DB_HOST=localhost
DB_PORT=5432
DB_NAME=media_ai
DB_USER=media_user
DB_PASS=media_pass

STORAGE_PATH=./storage

# Minimum cosine similarity for a photo to be returned by selfie search. 0.70 was chosen from a small
# LFW test (see docs/DECISIONS.md); it has NOT been calibrated on race-like photos and needs to be.
MIN_FACE_CONFIDENCE=0.70
# OCR-DISABLED: MIN_BIB_CONFIDENCE=60

# processing/batch.py concurrency — face embedding is capped by
# CompreFace's own UWSGI_PROCESSES/UWSGI_THREADS config (docker-compose.yml).
# OCR-DISABLED: OCR_WORKERS=4
FACE_WORKERS=2

# Stalled-batch safety net (processing/batch.py:sweep_stalled_events) —
# catches events whose upload-portal auto-trigger never fired (e.g. the
# browser closed too early). SWEEP_GRACE_MINUTES should comfortably exceed
# how long a normal upload session takes, so it doesn't fire on sessions
# that are still legitimately in progress.
SWEEP_INTERVAL_MINUTES=15
SWEEP_GRACE_MINUTES=15
BATCH_RUN_STALE_MINUTES=60

# CompreFace (face search) — UI/API at http://localhost:8001 once docker-compose is up.
# Generate the API key from a *Face Detection* service in the CompreFace admin UI
# (processing/face.py calls /api/v1/detection/detect, which needs a Detection key).
COMPREFACE_URL=http://localhost:8001
COMPREFACE_API_KEY=

# OCR-DISABLED: local dev only (Windows), set if tesseract.exe isn't on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Security ────────────────────────────────────────────────────────────────
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sent in the X-API-Key header. If a key is empty, its routes return 503.
# UPLOAD_API_KEY covers /upload*.
UPLOAD_API_KEY=
# ADMIN_API_KEY covers /admin/*; it is also accepted on /upload* and when fetching photos directly.
ADMIN_API_KEY=

# Signs the expiring photo links returned by search. If empty, search and photo serving return 503.
PHOTO_URL_SECRET=
PHOTO_URL_TTL_SECONDS=3600

MAX_UPLOAD_MB=25
MAX_SELFIE_MB=5
MAX_IMAGE_PIXELS=64000000

# Per client IP, in-process (not shared across workers; uses the socket address). 0 disables.
SEARCH_RATE_LIMIT_PER_MINUTE=10

# Stored with each consent record in search_requests.
CONSENT_VERSION=v1

# Comma-separated browser origins allowed to call the API. Empty = same-origin only.
CORS_ORIGINS=
